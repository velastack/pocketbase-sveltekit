{
    "version": "0.29.0",
    "name": "pocketbase-sveltekit",
    "description": "PocketBase JavaScript SDK for SvelteKit",
    "author": "Gani Georgiev",
    "license": "MIT",
    "homepage": "https://ganigeorgiev.com/pocketbase/js-sdk",
    "exports": {
        ".": {
            "types": "./dist/pocketbase.es.d.mts",
            "default": "./dist/pocketbase.es.mjs"
        }
    },
    "main": "./dist/pocketbase.es.mjs",
    "module": "./dist/pocketbase.es.mjs",
    "types": "./dist/pocketbase.es.d.mts",
    "engines": {
        "node": ">=20"
    },
    "peerDependencies": {
        "@sveltejs/kit": "^2.0.0 || ^3.0.0"
    },
    "peerDependenciesMeta": {
        "@sveltejs/kit": {
            "optional": true
        }
    },
    "overrides": {
        "browserslist-generator": "^3.0.0"
    },
    "keywords": [
        "pocketbase",
        "pocketbase-js",
        "js-sdk",
        "javascript-sdk",
        "pocketbase-sdk"
    ],
    "prettier": {
        "tabWidth": 4,
        "printWidth": 90,
        "bracketSameLine": true
    },
    "scripts": {
        "format": "npx prettier ./src ./tests --write",
        "build": "rm -rf dist && rollup -c",
        "dev": "rollup -c -w",
        "test": "vitest run",
        "prepublishOnly": "npm run build",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@sveltejs/kit": "^2.25.1",
        "prettier": "3.2.4",
        "rollup": "^4.0.0",
        "rollup-plugin-ts": "^3.0.0",
        "typescript": "^5.1.6",
        "vitest": "^2.0.0"
    },
    "files": [
        "dist",
        "CHANGELOG.md",
        "CHANGELOG-sveltekit.md"
    ],
    "repository": {
        "type": "git",
        "url": "git://github.com/velastack/pocketbase-sveltekit.git"
    }
}
